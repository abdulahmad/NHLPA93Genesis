{
  "name": "nhlpa93-build",
  "version": "1.0.0",
  "description": "Build scripts for NHLPA Hockey 93 (Sega Genesis)",
  "scripts": {
    "assets": "node tools/prebuild.js any",
    "extractassets": "node tools/extractAssets93.js nhlpa93retail.bin",
    "extractassets:reva": "node tools/extractAssets93.js nhlpa93retailRevA.bin",
    "build:retail": "node tools/build.js retail",
    "build:reva": "node tools/build.js reva",
    "build:dev": "node tools/build.js dev",
    "verify:retail": "node tools/verifyRom.js output/retail/nhl93.bin nhlpa93retail.bin",
    "verify:reva": "node tools/verifyRom.js output/reva/nhl93.bin nhlpa93retailRevA.bin",
    "clean": "node tools/build.js --clean"
  },
  "devDependencies": {
    "crc-32": "^1.2.2"
  },
  "author": "",
  "license": "ISC"
}
