;	Assembler macros used throughout the game: setting the VDP auto increment, writing print
;	strings with their length in front, hex digits, roster entries and pictures.

; VmInc: set the VDP auto-increment (register 15).
;   Emits: move.w #$8F00+(\1&255),Vctrl (one instruction, no data).
;   \1: bytes to step after each VDP data access (2 for word writes).
;   Example (middle93.asm:703): VmInc 2  -> move.w #$8F02,Vctrl
VmInc MACRO							;set video auto inc. mode
	move	#$8f00+(\1&255),Vctrl
	ENDM

; String: a print string with its length in front (print, printz and the string lists read it).
;   Emits: dc.w length (counts the word itself and any pad), each argument as dc.b in order, then
;   one 0 pad byte if the data would end on an odd address.
;   \1..\31: each a quoted text ('abc') or a byte expression (e.g. a control code -$ab,x,y).
;   Example (tables93.asm:151): String 'Period Over'
;     -> 00 0E 50 65 72 69 6F 64 20 4F 76 65 72 00
String  MACRO
        ; Store current position
@begin1  =   *
        ; Reserve space for length word
        dc.w    0
        ; Output the string bytes
        dc.b    \1					; first param
    IF NARG>1
        dc.b    \2					; second param
    ENDIF
    IF NARG>2
        dc.b    \3					; third param
    ENDIF
    IF NARG>3
        dc.b    \4					; fourth param
    ENDIF
    IF NARG>4
        dc.b    \5					; fifth param
    ENDIF
    IF NARG>5
        dc.b    \6					; sixth param
    ENDIF
    IF NARG>6
        dc.b    \7					; seventh param
    ENDIF
    IF NARG>7
        dc.b    \8					; eighth param
    ENDIF
    IF NARG>8
        dc.b    \9					; ninth param
    ENDIF
    IF NARG>9
        dc.b    \10					; tenth param
    ENDIF
    IF NARG>10
        dc.b    \11					; eleventh param
    ENDIF
    IF NARG>11
        dc.b    \12					; twelfth param
    ENDIF
    IF NARG>12
        dc.b    \13					; thirteenth param
    ENDIF
    IF NARG>13
        dc.b    \14					; fourteenth param
    ENDIF
    IF NARG>14
        dc.b    \15					; fifteenth param
    ENDIF
    IF NARG>15
        dc.b    \16
    ENDIF
    IF NARG>16
        dc.b    \17
    ENDIF
    IF NARG>17
        dc.b    \18
    ENDIF
    IF NARG>18
        dc.b    \19
    ENDIF
    IF NARG>19
        dc.b    \20
    ENDIF
    IF NARG>20
        dc.b    \21
    ENDIF
    IF NARG>21
        dc.b    \22
    ENDIF
    IF NARG>22
        dc.b    \23
    ENDIF
    IF NARG>23
        dc.b    \24
    ENDIF
    IF NARG>24
        dc.b    \25
    ENDIF
    IF NARG>25
        dc.b    \26
    ENDIF
    IF NARG>26
        dc.b    \27
    ENDIF
    IF NARG>27
        dc.b    \28
    ENDIF
    IF NARG>28
        dc.b    \29
    ENDIF
    IF NARG>29
        dc.b    \30
    ENDIF
    IF NARG>30
        dc.b    \31
    ENDIF
        ; Pad with zero if needed for word alignment
    IF *&1
        dc.b    0
    ENDIF
@end1    =   *
        ; Now write the length at the reserved position
        org     @begin1
        dc.w    @end1-@begin1		; Total length
        org     @end1
    ENDM

; StringB: the same bytes as String for strings under 256 bytes (the team name lists use it).
;   Emits: dc.w 0, each argument as dc.b, a 0 pad to even, then backfills only the low byte of the
;   length word (the length counts the word and the pad).
;   \1..\15: each a quoted text or a byte expression.
;   Example (teamdata93.asm:152): StringB 'All Stars East'
;     -> 00 10 41 6C 6C 20 53 74 61 72 73 20 45 61 73 74
StringB  MACRO
        ; Store current position
@begin1  =   *
        ; Reserve space for length word
        dc.w    0
        ; Output the string bytes
        dc.b    \1					; first param
    IF NARG>1
        dc.b    \2					; second param
    ENDIF
    IF NARG>2
        dc.b    \3					; third param
    ENDIF
    IF NARG>3
        dc.b    \4					; fourth param
    ENDIF
    IF NARG>4
        dc.b    \5					; fifth param
    ENDIF
    IF NARG>5
        dc.b    \6					; sixth param
    ENDIF
    IF NARG>6
        dc.b    \7					; seventh param
    ENDIF
    IF NARG>7
        dc.b    \8					; eighth param
    ENDIF
    IF NARG>8
        dc.b    \9					; ninth param
    ENDIF
    IF NARG>9
        dc.b    \10					; tenth param
    ENDIF
    IF NARG>10
        dc.b    \11					; eleventh param
    ENDIF
    IF NARG>11
        dc.b    \12					; twelfth param
    ENDIF
    IF NARG>12
        dc.b    \13					; thirteenth param
    ENDIF
    IF NARG>13
        dc.b    \14					; fourteenth param
    ENDIF
    IF NARG>14
        dc.b    \15					; fifteenth param
    ENDIF
        ; Pad with zero if needed for word alignment
    IF *&1
        dc.b    0
    ENDIF
@end1    =   *
        ; Now write the length at the reserved position
        org     @begin1+1
        dc.b    @end1-@begin1		; Total length
        org     @end1
    ENDM

; HEX2 (used as hex2): four big-endian words of hex data.
;   Emits: dc.w $\1,$\2,$\3,$\4 (8 bytes).
;   \1..\4: 4 hex digits each, written without $ (the macro adds it).
;   Example (teamdata93.asm:94): hex2 7020,00D6,9999,9099
;     -> 70 20 00 D6 99 99 90 99
HEX2 MACRO							; macro for hex data
    dc.w    $\1,$\2,$\3,$\4			; handle 4 words at a time, add $ prefix
    ENDM

; PLAYER (used as Player): one roster record.
;   Emits: dc.b 0, length (counts these 2 bytes, the name and the pad), the name, a 0 pad to even,
;   then 4 rating words dc.w $\2,$\3,$\4,$\5.
;   \1: the quoted name (the build puts the real names in place of the P001_ placeholders).
;   \2..\5: the ratings, 4 hex digits each, written without $.
;   Example (teamdata93.asm:128): Player 'P001_______',335F,AFFF,0100,FFFF
;     -> 00 0E 50 30 30 31 5F 5F 5F 5F 5F 5F 5F 00 33 5F AF FF 01 00 FF FF
PLAYER MACRO
    ; Store current position
@begin = *
    ; Reserve space for prefix: dc.b $00, length_byte
    dc.b $00, $00
    ; Output the name bytes
    dc.b \1
    ; Pad with 0x00 if name length is odd (to make name even)
    IF *&1
        dc.b $00					; or use $20 for space if preferred
    ENDIF
@end = *
    ; Now write the length byte at the reserved position (total size: prefix 2 + name + pad)
    org @begin+1
    dc.b @end-@begin
    org @end
    ; Output the remaining hex words
    dc.w $\2,$\3,$\4,$\5
    ENDM

; PIX1: one goalie save odds byte.
;   Emits: dc.b (d3<<6)+(d2<<4)+(d1<<2)+d0, where \1 is the four digits d3 d2 d1 d0, each 0-3.
;   \1: a four digit number, one digit (odds multiplier) per puck region.
;   Example (through PIX): PIX1 2131  -> 9D
PIX1    MACRO
        dc.b    ((\1/1000)<<6)+(((\1/100)-(\1/1000)*10)<<4)+(((\1/10)-(\1/100)*10)<<2)+(\1-(\1/10)*10)
        ENDM

; PIX: goalie save odds bytes, one PIX1 byte per argument.
;   Emits: PIX1 \1, then PIX1 \2 and PIX1 \3 when given (1 to 3 bytes).
;   \1..\3: four digit numbers, see PIX1.
;   Example (hockey93.asm:3024): pix 1111,2131,1213
;     -> 55 9D 67
PIX     MACRO
        PIX1    \1
        IF      NARG>1
            PIX1    \2
        ENDIF
        IF      NARG>2
            PIX1    \3
        ENDIF
        ENDM
