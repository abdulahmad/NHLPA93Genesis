;	Assembler macros used throughout the game: setting the VDP auto increment, writing print
;	strings with their length in front, hex digits, roster entries and pictures.

VmInc MACRO							;set video auto inc. mode
	move	#$8f00+(\1&255),Vctrl
	ENDM

String  MACRO
        ; Store current position
@begin1  =   *
        ; Reserve space for length word
        dc.w    0
        ; Output the string bytes
        dc.b    \1					; first param
    IF NARG>1
        dc.b    \2					; second param
    ENDIF
    IF NARG>2
        dc.b    \3					; third param
    ENDIF
    IF NARG>3
        dc.b    \4					; fourth param
    ENDIF
    IF NARG>4
        dc.b    \5					; fifth param
    ENDIF
    IF NARG>5
        dc.b    \6					; sixth param
    ENDIF
    IF NARG>6
        dc.b    \7					; seventh param
    ENDIF
    IF NARG>7
        dc.b    \8					; eighth param
    ENDIF
    IF NARG>8
        dc.b    \9					; ninth param
    ENDIF
    IF NARG>9
        dc.b    \10					; tenth param
    ENDIF
    IF NARG>10
        dc.b    \11					; eleventh param
    ENDIF
    IF NARG>11
        dc.b    \12					; twelfth param
    ENDIF
    IF NARG>12
        dc.b    \13					; thirteenth param
    ENDIF
    IF NARG>13
        dc.b    \14					; fourteenth param
    ENDIF
    IF NARG>14
        dc.b    \15					; fifteenth param
    ENDIF
        ; Pad with zero if needed for word alignment
    IF *&1
        dc.b    0
    ENDIF
@end1    =   *
        ; Now write the length at the reserved position
        org     @begin1
        dc.w    @end1-@begin1		; Total length
        org     @end1
    ENDM

StringB  MACRO
        ; Store current position
@begin1  =   *
        ; Reserve space for length word
        dc.w    0
        ; Output the string bytes
        dc.b    \1					; first param
    IF NARG>1
        dc.b    \2					; second param
    ENDIF
    IF NARG>2
        dc.b    \3					; third param
    ENDIF
    IF NARG>3
        dc.b    \4					; fourth param
    ENDIF
    IF NARG>4
        dc.b    \5					; fifth param
    ENDIF
    IF NARG>5
        dc.b    \6					; sixth param
    ENDIF
    IF NARG>6
        dc.b    \7					; seventh param
    ENDIF
    IF NARG>7
        dc.b    \8					; eighth param
    ENDIF
    IF NARG>8
        dc.b    \9					; ninth param
    ENDIF
    IF NARG>9
        dc.b    \10					; tenth param
    ENDIF
    IF NARG>10
        dc.b    \11					; eleventh param
    ENDIF
    IF NARG>11
        dc.b    \12					; twelfth param
    ENDIF
    IF NARG>12
        dc.b    \13					; thirteenth param
    ENDIF
    IF NARG>13
        dc.b    \14					; fourteenth param
    ENDIF
    IF NARG>14
        dc.b    \15					; fifteenth param
    ENDIF
        ; Pad with zero if needed for word alignment
    IF *&1
        dc.b    0
    ENDIF
@end1    =   *
        ; Now write the length at the reserved position
        org     @begin1+1
        dc.b    @end1-@begin1		; Total length
        org     @end1
    ENDM

HEX2 MACRO							; macro for hex data
    dc.w    $\1,$\2,$\3,$\4			; handle 4 words at a time, add $ prefix
    ENDM

PLAYER MACRO
    ; Store current position
@begin = *
    ; Reserve space for prefix: dc.b $00, length_byte
    dc.b $00, $00
    ; Output the name bytes
    dc.b \1
    ; Pad with 0x00 if name length is odd (to make name even)
    IF *&1
        dc.b $00					; or use $20 for space if preferred
    ENDIF
@end = *
    ; Now write the length byte at the reserved position (total size: prefix 2 + name + pad)
    org @begin+1
    dc.b @end-@begin
    org @end
    ; Output the remaining hex words
    dc.w $\2,$\3,$\4,$\5
    ENDM

; PIX macro: one goalie save odds byte per argument. Each argument is four digits, one per puck region
; (the order .list2 is read in: bits 7-6 first), each digit 0-3 being the odds multiplier for that region.
; PIX 1111,2131,1213 is $55,$9D,$67.
PIX1    MACRO
        dc.b    ((\1/1000)<<6)+(((\1/100)-(\1/1000)*10)<<4)+(((\1/10)-(\1/100)*10)<<2)+(\1-(\1/10)*10)
        ENDM

PIX     MACRO
        PIX1    \1
        IF      NARG>1
            PIX1    \2
        ENDIF
        IF      NARG>2
            PIX1    \3
        ENDIF
        ENDM
